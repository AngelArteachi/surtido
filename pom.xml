<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.9</version>
    <relativePath/>
  </parent>

  <groupId>mx.surtido</groupId>
  <artifactId>surtido</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Surtido</name>
  <description>Wholesale ordering for corner stores: an order saga over Kafka</description>

  <modules>
    <module>libs/contracts</module>
    <module>libs/messaging</module>
    <module>platform/discovery</module>
    <module>platform/gateway</module>
    <module>services/catalog</module>
    <module>services/orders</module>
    <module>services/payments</module>
    <module>services/shipping</module>
    <module>services/notifications</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <spring-cloud.version>2025.1.4</spring-cloud.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <plugins>
      <!-- `*IT` classes run in `mvn verify` against real Postgres containers. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>mx.surtido</groupId>
        <artifactId>contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>mx.surtido</groupId>
        <artifactId>messaging</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
